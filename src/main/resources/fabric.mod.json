{
  "schemaVersion": 1,
  "id": "fbr-to-world",
  "version": "${version}",
  "name": "FBR to World",
  "description": "Converts a Flashback .zip recording file into a playable singleplayer world by reading every chunk from the recording's cache.",
  "authors": ["peli_G", "PearitX2"],
  "contact": {
    "homepage": "https://github.com/peli-G/Flashback-Recording-To-World",
    "sources": "https://github.com/peli-G/Flashback-Recording-To-World",
    "issues": "https://github.com/peli-G/Flashback-Recording-To-World/issues"

  },
  "license": "https://github.com/peli-G/Flashback-Recording-To-World/blob/main/LICENSE",
  "icon": "assets/fbr-to-world/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.moulberry.fbrtoworld.FbrToWorldMod"
    ]
  },
  "mixins": [
    "fbr-to-world.mixins.json"
  ],
  "depends": {
    "fabricloader": "${depends_loader}",
    "minecraft": "${depends_minecraft}",
    "java": "${depends_java}",
    "fabric-api": "*"
  },
  "recommends": {
    "flashback": "*"
  }
}
